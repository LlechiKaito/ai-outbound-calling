import re, sys, os

def check_function_length(filepath):
    violations = []
    with open(filepath, 'r') as f:
        lines = f.readlines()
    
    func_pattern = re.compile(r'(async\s+)?(?:function\s+\w+|(?:\w+\s*(?::\s*\w+)?\s*\()|(?:(?:private|public|protected|static)\s+(?:async\s+)?(?:readonly\s+)?\w+\s*\())')
    
    # Simple brace counting approach
    i = 0
    while i < len(lines):
        line = lines[i].rstrip()
        stripped = line.strip()
        
        # Detect function/method start  
        is_func = False
        if re.match(r'\s*(async\s+)?function\s+\w+', line):
            is_func = True
        elif re.match(r'\s*(private|public|protected|static)\s+(readonly\s+)?(async\s+)?\w+\s*\(', line):
            is_func = True
        elif re.match(r'\s*async\s+\w+\s*\(', line):
            is_func = True
            
        if is_func:
            # Find opening brace
            start = i
            brace_count = 0
            found_open = False
            j = i
            while j < len(lines):
                for ch in lines[j]:
                    if ch == '{':
                        brace_count += 1
                        found_open = True
                    elif ch == '}':
                        brace_count -= 1
                if found_open and brace_count == 0:
                    func_lines = j - start + 1
                    if func_lines > 30:
                        violations.append((start + 1, j + 1, func_lines, stripped[:60]))
                    break
                j += 1
        i += 1
    return violations

for root, dirs, files in os.walk('backend/src'):
    dirs[:] = [d for d in dirs if d != 'node_modules']
    for fname in files:
        if fname.endswith('.ts'):
            fpath = os.path.join(root, fname)
            violations = check_function_length(fpath)
            for start, end, length, desc in violations:
                print(f'{fpath}:{start}-{end} ({length} lines): {desc}')
